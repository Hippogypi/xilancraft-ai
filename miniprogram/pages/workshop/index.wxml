<view class="xl-page">
  <view class="xl-page-head">
    <text class="xl-page-title">AI 定制工坊</text>
    <text class="xl-text-faint">AI 共创西兰卡普新纹样</text>
  </view>

  <!-- 参考纹样标签（素材库「以此为灵感」带入或本页选择），点 ✕ 移除 -->
  <view wx:if="{{referenceMotifId}}" class="ref-tag" catchtap="onRemoveReference">
    <view class="ref-tag__mark"></view>
    <text class="ref-tag__text">参考纹样：{{referenceMotifName}}</text>
    <view class="ref-tag__close">✕</view>
  </view>

  <!-- ① 提示词 textarea（200 字上限；服装风格/应用部位由用户自由描述，占位文案暗示） -->
  <xl-card title="创意提示词">
    <textarea
      class="prompt-input"
      value="{{prompt}}"
      maxlength="200"
      bindinput="onPromptInput"
      placeholder="描述你的创意：如「街头潮流风、胸前印花，结合四十八勾的菱形骨架，几何重组，主体醒目」"
      placeholder-class="xl-ph"
    ></textarea>
    <view class="prompt-count">{{prompt.length}}/200</view>
  </xl-card>

  <!-- ② 可视化配色：主色/辅助色卡片 + 快捷色板 + 可折叠自由调色 -->
  <xl-card title="配色方案">
    <!-- 主色（必选）/ 辅助色（可选，双色模式开关） -->
    <view class="cp-cards">
      <view class="cp-card {{activeSlot === 'main' ? 'cp-card--on' : ''}}" bindtap="onSelectMain">
        <view class="cp-card__swatch" style="background: {{mainHex}}"></view>
        <view class="cp-card__meta">
          <text class="cp-card__label">主色</text>
          <text class="cp-card__name">{{mainName}}</text>
        </view>
        <view wx:if="{{activeSlot === 'main'}}" class="cp-card__check">✓</view>
      </view>
      <view
        class="cp-card {{auxOn ? '' : 'cp-card--off'}} {{activeSlot === 'aux' ? 'cp-card--on' : ''}}"
        bindtap="onSelectAux"
      >
        <view class="cp-card__swatch {{auxOn ? '' : 'cp-card__swatch--empty'}}" style="{{auxOn ? 'background: ' + auxHex : ''}}">
          <text wx:if="{{!auxOn}}" class="cp-card__plus">＋</text>
        </view>
        <view class="cp-card__meta">
          <text class="cp-card__label">辅助色</text>
          <text class="cp-card__name">{{auxOn ? auxName : '点击启用双色'}}</text>
        </view>
        <view wx:if="{{activeSlot === 'aux'}}" class="cp-card__check">✓</view>
        <view wx:if="{{auxOn}}" class="cp-card__close" catchtap="onDisableAux">✕</view>
      </view>
    </view>

    <!-- 快捷色板：6 精选色块（传统织锦色 + 现代设计色） -->
    <view class="cp-swatches">
      <view
        wx:for="{{swatches}}"
        wx:key="hex"
        class="cp-sw {{(activeSlot === 'main' && item.hex === mainHex) || (activeSlot === 'aux' && auxOn && item.hex === auxHex) ? 'cp-sw--on' : ''}}"
        style="background: {{item.hex}}"
        data-idx="{{index}}"
        bindtap="onSwatchTap"
      >
        <text class="cp-sw__tick">✓</text>
      </view>
    </view>

    <!-- 更多颜色 · 自由调色（默认折叠） -->
    <view class="cp-custom-head" bindtap="onToggleCustom">
      <text class="cp-custom-head__text">更多颜色 · 自由调色</text>
      <text class="cp-custom-head__arrow">{{customOpen ? '▲' : '▼'}}</text>
    </view>
    <view wx:if="{{customOpen}}" class="cp-custom">
      <view class="cp-live">
        <view class="cp-live__swatch" style="background: {{liveHex}}"></view>
        <text class="cp-live__name">{{liveName}}</text>
      </view>
      <view class="cp-slider">
        <text class="cp-slider__name">色相</text>
        <slider class="cp-slider__bar" min="0" max="360" step="1" value="{{h}}" activeColor="#C9A063" backgroundColor="#2E251B" block-size="20" block-color="#C9A063" bindchanging="onHueChange" bindchange="onHueChange" />
      </view>
      <view class="cp-slider">
        <text class="cp-slider__name">饱和度</text>
        <slider class="cp-slider__bar" min="0" max="100" step="1" value="{{s}}" activeColor="#C9A063" backgroundColor="#2E251B" block-size="20" block-color="#C9A063" bindchanging="onSatChange" bindchange="onSatChange" />
      </view>
      <view class="cp-slider">
        <text class="cp-slider__name">明度</text>
        <slider class="cp-slider__bar" min="8" max="92" step="1" value="{{l}}" activeColor="#C9A063" backgroundColor="#2E251B" block-size="20" block-color="#C9A063" bindchanging="onLightChange" bindchange="onLightChange" />
      </view>
      <view class="xl-actions">
        <xl-button type="primary" text="使用这个颜色" bind:tap="onUseLiveColor"></xl-button>
      </view>
    </view>

    <text class="xl-text-faint cp-hint">{{auxOn ? '双色模式：主色为主、辅助色点缀' : '单色模式：可用黑白中性色辅助构图'}}</text>
  </xl-card>

  <!-- ⑤ 参考纹样横滑条（来自素材库带入或本页选择） -->
  <xl-card title="参考纹样（可选）">
    <scroll-view scroll-x class="ref-scroll" enable-flex>
      <view class="ref-row">
        <view
          wx:for="{{referenceMotifs}}"
          wx:key="id"
          class="ref-item {{referenceMotifId === item.id ? 'ref-item--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onRefTap"
        >
          <view class="ref-item__img xl-weave">
            <image wx:if="{{item.image}}" src="{{item.image}}" class="ref-item__image" mode="aspectFill"></image>
            <view wx:else class="ref-item__ph"></view>
          </view>
          <text class="ref-item__name">{{item.name}}</text>
        </view>
        <view
          class="ref-item {{referenceMotifId === '' ? 'ref-item--active' : ''}}"
          data-id=""
          bindtap="onRefTap"
        >
          <view class="ref-item__img ref-item__img--none"><text class="ref-item__none">无</text></view>
          <text class="ref-item__name">不使用</text>
        </view>
      </view>
    </scroll-view>
    <text class="xl-text-faint ref-hint">选择后生成请求将携带 referenceMotifId，并把纹样名称与关键词注入提示词</text>
  </xl-card>

  <!-- ⑧ 免费额度/限频提示位 -->
  <view class="quota-note">
    <view class="quota-note__mark"></view>
    <text class="quota-note__text">比赛演示期间每日免费生成次数有限，生成约需数十秒，请耐心等待、避免连点。</text>
  </view>

  <!-- ⑥ 大号生成按钮（running 时 disabled + loading 防重复） -->
  <view class="xl-actions">
    <xl-button
      type="primary"
      text="{{genStatus === 'running' ? '生成中…' : '生成新纹样'}}"
      loading="{{genStatus === 'running'}}"
      disabled="{{genStatus === 'running'}}"
      bind:tap="onGenerate"
    ></xl-button>
  </view>

  <!-- ⑦ 状态区：生成中 / 成功 / 失败（超时、额度不足同失败态，文案按错误码映射） -->
  <view class="gen-status">
    <!-- 生成中 -->
    <block wx:if="{{genStatus === 'running'}}">
      <xl-card>
        <xl-loading text="AI 正在创作，约需数十秒…"></xl-loading>
        <view class="gen-cancel-hint">
          <xl-status-dot type="running" label="任务进行中，请稍候"></xl-status-dot>
          <text class="xl-text-faint">请勿重复提交，以免超出每日免费额度</text>
        </view>
      </xl-card>
    </block>

    <!-- 成功 -->
    <block wx:elif="{{genStatus === 'succeeded'}}">
      <xl-card title="生成结果">
        <view class="gen-result__imgwrap xl-weave">
          <image wx:if="{{genResult.imageUrl}}" class="gen-result__img" src="{{genResult.imageUrl}}" mode="aspectFit"></image>
        </view>
        <view class="gen-prompt-link" bindtap="onViewPrompt">查看提交的完整提示词</view>
        <view class="xl-actions xl-actions--pair">
          <xl-button type="ghost" text="重新生成" bind:tap="onGenerate"></xl-button>
          <xl-button type="primary" text="用此纹样 → 定制" bind:tap="onUsePattern"></xl-button>
        </view>
      </xl-card>
    </block>

    <!-- 失败 / 超时 / 额度不足 -->
    <block wx:elif="{{genStatus === 'failed'}}">
      <xl-card title="生成失败">
        <view class="gen-error">
          <view class="gen-error__icon"></view>
          <text class="gen-error__text">{{errorMsg}}</text>
        </view>
        <view class="xl-actions">
          <xl-button type="ghost" text="重试" bind:tap="onGenerate"></xl-button>
        </view>
        <text class="xl-text-faint gen-error__tip">若持续失败，工作人员可在管理端切换 AI 服务</text>
      </xl-card>
    </block>
  </view>

  <view class="xl-demo-note">比赛演示 · 生成结果与管理端记录联动</view>
</view>

<view class="xl-page">
  <view class="xl-page-head">
    <text class="xl-page-title">AI 定制工坊</text>
    <text class="xl-text-faint">AI 共创西兰卡普新纹样</text>
  </view>

  <!-- ① 提示词 textarea（200 字上限） -->
  <xl-card title="创意提示词">
    <textarea
      class="prompt-input"
      value="{{prompt}}"
      maxlength="200"
      bindinput="onPromptInput"
      placeholder="例：解构四十八勾纹样，几何重组为街头潮流卫衣胸前印花，黑金配色，主体清晰"
      placeholder-class="xl-ph"
    ></textarea>
    <view class="prompt-count">{{prompt.length}}/200</view>
  </xl-card>

  <!-- ② 风格 chips -->
  <xl-card title="服装风格">
    <xl-chips options="{{styles}}" value="{{styleValue}}" bind:change="onStyleChange"></xl-chips>
  </xl-card>

  <!-- ③ 配色 chips -->
  <xl-card title="配色方案">
    <xl-chips options="{{palettes}}" value="{{paletteValue}}" bind:change="onPaletteChange"></xl-chips>
  </xl-card>

  <!-- ④ 应用部位 chips -->
  <xl-card title="应用部位">
    <xl-chips options="{{placements}}" value="{{placementValue}}" bind:change="onPlacementChange"></xl-chips>
  </xl-card>

  <!-- ⑤ 参考纹样横滑条（来自素材库带入或本页选择） -->
  <xl-card title="参考纹样（可选）">
    <scroll-view scroll-x class="ref-scroll" enable-flex>
      <view class="ref-row">
        <view
          wx:for="{{referenceMotifs}}"
          wx:key="id"
          class="ref-item {{referenceMotifId === item.id ? 'ref-item--active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onRefTap"
        >
          <view class="ref-item__img xl-weave">
            <image wx:if="{{item.image}}" src="{{item.image}}" class="ref-item__image" mode="aspectFill"></image>
            <view wx:else class="ref-item__ph"></view>
          </view>
          <text class="ref-item__name">{{item.name}}</text>
        </view>
        <view
          class="ref-item {{referenceMotifId === '' ? 'ref-item--active' : ''}}"
          data-id=""
          bindtap="onRefTap"
        >
          <view class="ref-item__img ref-item__img--none"><text class="ref-item__none">无</text></view>
          <text class="ref-item__name">不使用</text>
        </view>
      </view>
    </scroll-view>
    <text wx:if="{{referenceMotifName}}" class="xl-text-faint">已选参考：{{referenceMotifName}}（生成时将注入纹样关键词）</text>
  </xl-card>

  <!-- ⑧ 免费额度/限频提示位 -->
  <view class="quota-note">
    <view class="quota-note__mark"></view>
    <text class="quota-note__text">比赛演示期间每日免费生成次数有限，生成约需 10~120 秒，请耐心等待、避免连点。</text>
  </view>

  <!-- ⑥ 大号生成按钮 -->
  <view class="xl-actions">
    <xl-button
      type="primary"
      text="{{genStatus === 'running' ? '生成中…' : '生成新纹样'}}"
      loading="{{genStatus === 'running'}}"
      disabled="{{genStatus === 'running'}}"
      bind:tap="onGenerate"
    ></xl-button>
  </view>

  <!-- ⑦ 状态区：生成中 / 成功 / 失败 -->
  <view class="gen-status">
    <!-- 生成中 -->
    <block wx:if="{{genStatus === 'running'}}">
      <xl-card>
        <xl-loading text="AI 正在织造新纹样，约需 10~120 秒…"></xl-loading>
        <view class="gen-cancel-hint">
          <xl-status-dot type="running" label="任务进行中，可稍作等待"></xl-status-dot>
          <text class="xl-text-faint">请勿重复提交，以免超出每日免费额度</text>
        </view>
      </xl-card>
    </block>

    <!-- 成功 -->
    <block wx:elif="{{genStatus === 'succeeded'}}">
      <xl-card title="生成结果">
        <view class="gen-result__imgwrap xl-weave">
          <image wx:if="{{genResult.imageUrl}}" class="gen-result__img" src="{{genResult.imageUrl}}" mode="aspectFit"></image>
          <block wx:else>
            <view class="gen-result__ph"></view>
            <text class="gen-result__ph-text">结果图占位（阶段 3 接真实生成后展示 AI 图片）</text>
          </block>
        </view>
        <view class="xl-actions xl-actions--pair">
          <xl-button type="ghost" text="重新生成" bind:tap="onGenerate"></xl-button>
          <xl-button type="primary" text="用此纹样 → 定制" bind:tap="onUsePattern"></xl-button>
        </view>
      </xl-card>
    </block>

    <!-- 失败 -->
    <block wx:elif="{{genStatus === 'failed'}}">
      <xl-card title="生成失败">
        <view class="gen-error">
          <view class="gen-error__icon"></view>
          <text class="gen-error__text">{{errorMsg}}</text>
        </view>
        <view class="xl-actions">
          <xl-button type="ghost" text="重试" bind:tap="onGenerate"></xl-button>
        </view>
        <text class="xl-text-faint gen-error__tip">多次失败可联系工作人员在管理端切换 AI 服务</text>
      </xl-card>
    </block>
  </view>

  <view class="xl-demo-note">比赛演示 · 生成结果与管理端记录联动</view>
</view>

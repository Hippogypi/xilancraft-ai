/* ============ 提示词输入 ============ */
.prompt-input {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: var(--xl-bg-card-2);
  border: 1rpx solid var(--xl-gold-40);
  border-radius: 12rpx;
  color: var(--xl-text);
  font-size: 28rpx;
  line-height: 1.6;
}
.prompt-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--xl-text-faint);
}

/* ============ 参考纹样横滑条 ============ */
.ref-scroll {
  width: 100%;
  white-space: nowrap;
}
.ref-row {
  display: flex;
  padding-bottom: 8rpx;
}
.ref-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
}
.ref-item__img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--xl-gold-40);
  background-color: var(--xl-bg-card-2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}
.ref-item--active .ref-item__img {
  border-color: var(--xl-gold);
  box-shadow: 0 0 0 2rpx rgba(201, 160, 99, 0.25);
}
.ref-item__image {
  width: 100%;
  height: 100%;
}
.ref-item__ph {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid var(--xl-gold-40);
  border-radius: 4rpx;
  transform: rotate(45deg);
}
.ref-item__img--none {
  background: var(--xl-bg-card-2);
}
.ref-item__none {
  font-size: 24rpx;
  color: var(--xl-text-faint);
}
.ref-item__name {
  margin-top: 10rpx;
  max-width: 130rpx;
  font-size: 20rpx;
  color: var(--xl-text-sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ref-item--active .ref-item__name {
  color: var(--xl-gold);
}

/* ============ 免费额度/限频提示 ============ */
.quota-note {
  display: flex;
  align-items: flex-start;
  background: rgba(230, 126, 34, 0.08);
  border: 1rpx solid rgba(230, 126, 34, 0.35);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 8rpx;
}
.quota-note__mark {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  background: var(--xl-warning);
  transform: rotate(45deg);
  border-radius: 2rpx;
  margin: 12rpx 16rpx 0 0;
}
.quota-note__text {
  font-size: 22rpx;
  color: var(--xl-text-sub);
  line-height: 1.6;
}

/* ============ 生成状态区 ============ */
.gen-status {
  margin-top: 24rpx;
}
.gen-cancel-hint {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.gen-cancel-hint .xl-text-faint {
  margin-top: 8rpx;
}
/* 成功结果图占位 */
.gen-result__imgwrap {
  height: 420rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--xl-gold-40);
  background-color: var(--xl-bg-card-2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.gen-result__img {
  width: 100%;
  height: 100%;
}
.gen-result__ph {
  width: 96rpx;
  height: 96rpx;
  border: 3rpx solid var(--xl-gold-40);
  border-radius: 10rpx;
  transform: rotate(45deg);
  position: relative;
}
.gen-result__ph::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 32rpx;
  height: 32rpx;
  margin: -16rpx 0 0 -16rpx;
  background: var(--xl-gold-40);
  border-radius: 4rpx;
}
.gen-result__ph-text {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--xl-text-faint);
}
/* 失败态 */
.gen-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}
.gen-error__icon {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid var(--xl-danger);
  border-radius: 8rpx;
  transform: rotate(45deg);
  position: relative;
  margin-bottom: 24rpx;
}
.gen-error__icon::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  margin: -10rpx 0 0 -10rpx;
  background: var(--xl-danger);
  border-radius: 3rpx;
}
.gen-error__text {
  font-size: 26rpx;
  color: var(--xl-danger);
  text-align: center;
}
.gen-error__tip {
  display: block;
  margin-top: 16rpx;
  text-align: center;
}

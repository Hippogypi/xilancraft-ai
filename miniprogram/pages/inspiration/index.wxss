/* ============ ② 2 列网格 ============ */
.motif-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 8rpx;
}
.motif-card {
  width: 48.5%;
  margin-bottom: 24rpx;
  background: var(--xl-bg-card);
  border: 1rpx solid var(--xl-gold-40);
  border-radius: 16rpx;
  overflow: hidden;
}
.motif-card__imgwrap {
  position: relative;
  height: 220rpx;
  background-color: var(--xl-bg-card-2);
}
.motif-card__img {
  width: 100%;
  height: 100%;
  display: block;
}
/* image 空串/加载失败 → 几何占位色块（按分类取暖红金 / 织线蓝色调） */
.motif-card__ph {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.motif-card__ph--trad {
  background-color: #2A2118;
  background-image:
    repeating-linear-gradient(45deg, rgba(166, 43, 43, 0.34) 0 14rpx, transparent 14rpx 30rpx),
    repeating-linear-gradient(-45deg, rgba(201, 160, 99, 0.2) 0 14rpx, transparent 14rpx 30rpx);
}
.motif-card__ph--modern {
  background-color: #232430;
  background-image:
    repeating-linear-gradient(45deg, rgba(58, 110, 165, 0.3) 0 14rpx, transparent 14rpx 30rpx),
    repeating-linear-gradient(-45deg, rgba(201, 160, 99, 0.14) 0 14rpx, transparent 14rpx 30rpx);
}
/* 菱中菱装饰 */
.motif-card__ph-diamond {
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid var(--xl-gold-40);
  border-radius: 6rpx;
  transform: rotate(45deg);
  position: relative;
}
.motif-card__ph-diamond::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 18rpx;
  margin: -9rpx 0 0 -9rpx;
  background: var(--xl-gold-40);
  border-radius: 3rpx;
}
/* 「纹样示意」角标（左上；右上为分类 tag） */
.motif-card__ph-badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--xl-text-sub);
  background: rgba(22, 18, 14, 0.6);
  border: 1rpx solid var(--xl-gold-40);
}
/* 分类角标：traditional 金 / modern 织线蓝 */
.motif-card__tag,
.detail__tag {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}
.motif-card__tag--trad {
  color: var(--xl-gold);
  background: rgba(201, 160, 99, 0.16);
  border: 1rpx solid var(--xl-gold);
}
.motif-card__tag--modern {
  color: var(--xl-thread-blue);
  background: rgba(58, 110, 165, 0.16);
  border: 1rpx solid rgba(58, 110, 165, 0.55);
}
.motif-card__body {
  padding: 16rpx 20rpx 20rpx;
  display: flex;
  flex-direction: column;
}
.motif-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--xl-text);
}
/* 寓意截断一行 */
.motif-card__meaning {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--xl-text-sub);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.motif-card__more {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--xl-gold);
}

/* ============ ④ 传统 vs 现代 对比卡（WBS 03.04） ============ */
.vs {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.vs__item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.vs__img {
  width: 100%;
  height: 170rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--xl-gold-40);
  background-color: var(--xl-bg-card-2);
  position: relative;
  overflow: hidden;
}
.vs__photo {
  width: 100%;
  height: 100%;
  display: block;
}
.vs__decor {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.vs__decor--trad {
  background-color: #2A2118;
  background-image:
    repeating-linear-gradient(45deg, rgba(192, 57, 43, 0.45) 0 14rpx, transparent 14rpx 30rpx),
    repeating-linear-gradient(-45deg, rgba(233, 185, 76, 0.25) 0 14rpx, transparent 14rpx 30rpx);
}
.vs__core {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid var(--xl-gold);
  border-radius: 6rpx;
  transform: rotate(45deg);
  background: rgba(22, 18, 14, 0.35);
}
.vs__decor--modern {
  background-color: #2E251B;
}
.vs__chip {
  position: absolute;
  border-radius: 6rpx;
}
.vs__chip--1 {
  width: 42%;
  height: 42%;
  left: 6%;
  top: 10%;
  background: var(--xl-thread-blue);
  opacity: 0.75;
}
.vs__chip--2 {
  width: 50%;
  height: 30%;
  right: 4%;
  top: 38%;
  background: var(--xl-primary);
  opacity: 0.85;
}
.vs__chip--3 {
  width: 34%;
  height: 26%;
  left: 26%;
  bottom: 8%;
  background: var(--xl-thread-yellow);
  opacity: 0.7;
}
.vs__label {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--xl-text-sub);
}
.vs__sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--xl-text-faint);
  text-align: center;
}
/* 中间箭头 */
.vs__arrow {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 12rpx 0;
}
.vs__arrow-line {
  font-size: 36rpx;
  color: var(--xl-gold);
  margin-top: 4rpx;
}
.vs__arrow-text {
  font-size: 20rpx;
  color: var(--xl-text-faint);
}

/* ============ ③ 详情弹层 ============ */
.detail__imgwrap {
  position: relative;
  height: 380rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--xl-gold-40);
  background-color: var(--xl-bg-card-2);
  overflow: hidden;
}
.detail__img {
  width: 100%;
  height: 100%;
  display: block;
}
/* 大图占位（同网格容错） */
.detail__ph {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.detail__ph--trad {
  background-color: #2A2118;
  background-image:
    repeating-linear-gradient(45deg, rgba(166, 43, 43, 0.34) 0 18rpx, transparent 18rpx 38rpx),
    repeating-linear-gradient(-45deg, rgba(201, 160, 99, 0.2) 0 18rpx, transparent 18rpx 38rpx);
}
.detail__ph--modern {
  background-color: #232430;
  background-image:
    repeating-linear-gradient(45deg, rgba(58, 110, 165, 0.3) 0 18rpx, transparent 18rpx 38rpx),
    repeating-linear-gradient(-45deg, rgba(201, 160, 99, 0.14) 0 18rpx, transparent 18rpx 38rpx);
}
.detail__ph-diamond {
  width: 84rpx;
  height: 84rpx;
  border: 3rpx solid var(--xl-gold-40);
  border-radius: 8rpx;
  transform: rotate(45deg);
  position: relative;
}
.detail__ph-diamond::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 28rpx;
  height: 28rpx;
  margin: -14rpx 0 0 -14rpx;
  background: var(--xl-gold-40);
  border-radius: 4rpx;
}
.detail__ph-text {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: var(--xl-text-faint);
}
.detail__tag {
  right: 16rpx;
  top: 16rpx;
}
.detail__section {
  margin-top: 28rpx;
}
.detail__label {
  display: block;
  font-size: 24rpx;
  color: var(--xl-gold);
  margin-bottom: 10rpx;
}
.detail__text {
  display: block;
  font-size: 26rpx;
  color: var(--xl-text-sub);
  line-height: 1.7;
}
/* 来源说明：小字 */
.detail__source {
  display: block;
  font-size: 22rpx;
  color: var(--xl-text-faint);
  line-height: 1.6;
}
.detail__keywords {
  display: flex;
  flex-wrap: wrap;
}
.detail__keywords .xl-tag {
  margin: 0 12rpx 12rpx 0;
}
/* 「以此为灵感」金色按钮：ghost 金描边 + 金淡底（宿主元素样式） */
.detail__cta {
  display: block;
  margin-top: 36rpx;
  background: rgba(201, 160, 99, 0.1);
  border-radius: 12rpx;
}
/* referenceAllowed=false 的替代说明 */
.detail__denied {
  margin-top: 32rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx dashed var(--xl-gold-40);
  font-size: 24rpx;
  color: var(--xl-text-faint);
  text-align: center;
}

<!-- ① 空态：无纹样时引导去工坊 -->
<block wx:if="{{!pattern}}">
  <view class="xl-page">
    <view class="xl-page-head">
      <text class="xl-page-title">服装定制</text>
      <text class="xl-text-faint">纹样叠加预览 · 模拟订单</text>
    </view>
    <view class="empty-wrap">
      <xl-empty text="还没有可定制的纹样"></xl-empty>
      <text class="xl-text-sub empty-tip">先去 AI 工坊生成一张西兰卡普新纹样，再回到这里叠加到服装上</text>
      <view class="xl-actions">
        <xl-button type="primary" text="去 AI 工坊生成纹样" bind:tap="goWorkshop"></xl-button>
      </view>
    </view>
    <view class="xl-demo-note">比赛演示 · 模拟数据 · 无支付环节</view>
  </view>
</block>

<!-- ⑦ 提交成功态 -->
<block wx:elif="{{submitted}}">
  <view class="xl-page">
    <view class="xl-card success-card">
      <view class="success-card__icon"></view>
      <text class="success-card__title">定制意向已提交</text>
      <text class="success-card__no">{{orderNo}}</text>
      <text class="xl-text-sub success-card__note">工作人员可在管理端查看此订单。本单为比赛演示模拟订单，不产生真实交易与支付。</text>
      <view class="xl-actions">
        <xl-button type="primary" text="返回首页" bind:tap="goHome"></xl-button>
      </view>
      <view class="xl-actions">
        <xl-button type="ghost" text="再去生成一张" bind:tap="goWorkshop"></xl-button>
      </view>
    </view>
    <view class="xl-demo-note">比赛演示 · 模拟数据 · 无支付环节</view>
  </view>
</block>

<!-- 主流程：预览 + 模板 + 滑杆 + 表单 -->
<block wx:else>
  <view class="xl-page">
    <view class="xl-page-head">
      <text class="xl-page-title">服装定制</text>
      <text class="xl-text-faint">纹样叠加预览 · 模拟订单</text>
    </view>

    <!-- ① 预览区：服装底图 + 纹样自由摆放（衣服轮廓=剪辑蒙版，越界自动裁剪；支持拖拽） -->
    <view class="preview">
      <view
        class="preview__stage"
        catchtouchstart="onStageTouchStart"
        catchtouchmove="onStageTouchMove"
        catchtouchend="onStageTouchEnd"
      >
        <!-- 服装剪影占位（底图 PNG 缺失时兜底） -->
        <block wx:if="{{!garment.image}}">
          <view class="g-body"></view>
          <view class="g-sleeve g-sleeve--l"></view>
          <view class="g-sleeve g-sleeve--r"></view>
        </block>
        <image wx:if="{{garment.image}}" class="preview__garment-img" src="{{garment.image}}" mode="aspectFit"></image>

        <!-- 纹样层：满画布自由定位；以服装PNG为剪辑蒙版，超出衣服轮廓自动裁剪 -->
        <view
          wx:if="{{garment.image}}"
          class="preview__masklayer"
          style="-webkit-mask-image:url('{{maskSrc}}');-webkit-mask-size:100% 100%;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;"
        >
          <view
            class="preview__pattern"
            style="left:{{patLeft}}%;top:{{patTop}}%;width:{{patW}}%;height:{{patW}}%;opacity:{{patOp}};"
          >
            <image class="preview__pattern-img" src="{{pattern.imageUrl}}" mode="aspectFit"></image>
          </view>
        </view>

        <view class="preview__label">{{garment.name}} · 拖动纹样自由摆放，超出轮廓自动裁剪</view>
      </view>
    </view>

    <!-- ② 模板横滑单选 -->
    <xl-card title="服装模板">
      <scroll-view scroll-x class="tpl-scroll">
        <view class="tpl-row">
          <view
            wx:for="{{garments}}"
            wx:key="id"
            class="tpl-item {{garmentId === item.id ? 'tpl-item--active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onGarmentTap"
          >
            <view class="tpl-item__img xl-weave">
              <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit"></image>
              <view wx:else class="tpl-item__ph"></view>
            </view>
            <text class="tpl-item__name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </xl-card>

    <!-- ③ 调节滑杆：大小 / 水平 / 垂直 / 透明度（拖动实时生效） -->
    <xl-card title="纹样调节">
      <view class="ctrl">
        <view class="ctrl__row"><text class="ctrl__name">大小</text><text class="ctrl__val">{{scalePct}}%</text></view>
        <slider class="ctrl__slider" min="50" max="200" step="5" value="{{scalePct}}" activeColor="#C9A063" backgroundColor="#2E251B" block-size="20" block-color="#C9A063" bindchange="onScaleChange" bindchanging="onScaleChange" />
      </view>
      <view class="ctrl">
        <view class="ctrl__row"><text class="ctrl__name">水平位置</text><text class="ctrl__val">{{offsetX > 0 ? '+' : ''}}{{offsetX}}%</text></view>
        <slider class="ctrl__slider" min="-50" max="50" step="1" value="{{offsetX}}" activeColor="#C9A063" backgroundColor="#2E251B" block-size="20" block-color="#C9A063" bindchange="onOffsetXChange" bindchanging="onOffsetXChange" />
      </view>
      <view class="ctrl">
        <view class="ctrl__row"><text class="ctrl__name">垂直位置</text><text class="ctrl__val">{{offsetY > 0 ? '+' : ''}}{{offsetY}}%</text></view>
        <slider class="ctrl__slider" min="-50" max="50" step="1" value="{{offsetY}}" activeColor="#C9A063" backgroundColor="#2E251B" block-size="20" block-color="#C9A063" bindchange="onOffsetYChange" bindchanging="onOffsetYChange" />
      </view>
      <view class="ctrl ctrl--last">
        <view class="ctrl__row"><text class="ctrl__name">透明度</text><text class="ctrl__val">{{opacityPct}}%</text></view>
        <slider class="ctrl__slider" min="30" max="100" step="5" value="{{opacityPct}}" activeColor="#C9A063" backgroundColor="#2E251B" block-size="20" block-color="#C9A063" bindchange="onOpacityChange" bindchanging="onOpacityChange" />
      </view>
    </xl-card>

    <!-- ④ 尺码 chips + 数量 stepper -->
    <xl-card title="尺码与数量">
      <xl-chips options="{{sizes}}" value="{{sizeValue}}" bind:change="onSizeChange"></xl-chips>
      <view class="qty">
        <text class="qty__label">数量</text>
        <view class="stepper">
          <view class="stepper__btn" bindtap="onMinus">−</view>
          <text class="stepper__num">{{quantity}}</text>
          <view class="stepper__btn" bindtap="onPlus">＋</view>
        </view>
      </view>
    </xl-card>

    <!-- ⑤ 联系人表单（预填演示虚构数据，红字校验） -->
    <xl-card title="联系信息（演示）">
      <view class="xl-form-item">
        <text class="xl-form-label">姓名</text>
        <input class="xl-input" value="{{name}}" bindinput="onNameInput" placeholder="请输入姓名" placeholder-class="xl-ph" />
        <text wx:if="{{nameError}}" class="xl-form-error form-error">{{nameError}}</text>
      </view>
      <view class="xl-form-item xl-form-item--last">
        <text class="xl-form-label">联系电话</text>
        <input class="xl-input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" placeholder="请输入手机号" placeholder-class="xl-ph" />
        <text wx:if="{{phoneError}}" class="xl-form-error form-error">{{phoneError}}</text>
      </view>
    </xl-card>

    <!-- ⑥ 隐私 checkbox：未勾选拦截提交 -->
    <view class="privacy {{privacyError ? 'privacy--error' : ''}}" bindtap="onPrivacyToggle">
      <view class="privacy__box {{privacyAccepted ? 'privacy__box--on' : ''}}">
        <view wx:if="{{privacyAccepted}}" class="privacy__tick"></view>
      </view>
      <text class="privacy__text">本单为比赛演示模拟订单，不产生真实交易与支付；提交即表示同意以上说明。</text>
    </view>

    <!-- 提交失败提示（表单保留，按钮即为重试入口） -->
    <view wx:if="{{submitError}}" class="submit-error">
      <view class="submit-error__icon"></view>
      <text class="submit-error__text">{{submitError}}</text>
    </view>

    <!-- 提交按钮 -->
    <view class="xl-actions">
      <xl-button type="primary" text="{{submitError ? '重新提交' : '提交定制意向'}}" loading="{{submitting}}" disabled="{{submitting}}" bind:tap="onSubmit"></xl-button>
    </view>

    <view class="xl-demo-note">比赛演示 · 模拟数据 · 无支付环节</view>
  </view>
</block>

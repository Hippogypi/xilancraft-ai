/* 关键词搜索行 */
.order-search {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.order-search__input {
  flex: 1;
}
.order-search__btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  color: var(--xl-gold);
  border: 1rpx solid var(--xl-gold-40);
  border-radius: 12rpx;
  padding: 14rpx 28rpx;
}

/* 加载更多 / 全部加载完 */
.order-more {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}
.order-end {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
}
.order {
  display: flex;
  flex-direction: column;
}
.order__row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order__no {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--xl-text);
  letter-spacing: 1rpx;
}
.order__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--xl-text-sub);
}
.order__foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order__more {
  font-size: 22rpx;
  color: var(--xl-gold);
}

.order-demo-tip {
  text-align: left;
  margin: 0 0 24rpx;
}
.order {
  display: flex;
  flex-direction: column;
}
.order__row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order__no {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--xl-text);
  letter-spacing: 1rpx;
}
.order__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--xl-text-sub);
}
.order__foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.order__more {
  font-size: 22rpx;
  color: var(--xl-gold);
}

.prov-tip {
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.prov {
  display: flex;
  flex-direction: column;
}
.prov__row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.prov__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--xl-text);
}
.prov__meta {
  display: flex;
  margin-top: 10rpx;
}
.prov__type {
  font-size: 22rpx;
  color: var(--xl-thread-blue);
  background: rgba(58, 110, 165, 0.14);
  border: 1rpx solid rgba(58, 110, 165, 0.45);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
  margin-right: 12rpx;
}
.prov__model {
  font-size: 22rpx;
  color: var(--xl-text-sub);
  background: var(--xl-bg-card-2);
  border: 1rpx solid var(--xl-gold-40);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}
.prov__foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.prov-add {
  margin-top: 40rpx;
}

/* 密钥状态小标 */
.prov__key {
  font-size: 22rpx;
  color: var(--xl-success);
  background: rgba(62, 142, 90, 0.12);
  border: 1rpx solid rgba(62, 142, 90, 0.45);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
  margin-left: 12rpx;
}

/* 操作行 */
.prov__ops {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--xl-gold-40);
  display: flex;
  align-items: center;
}
.prov__op {
  margin-right: 20rpx;
}

/* 测试生成结果 */
.prov__test {
  margin-top: 20rpx;
  background: var(--xl-bg-card-2);
  border: 1rpx solid var(--xl-gold-40);
  border-radius: 12rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
}
.prov__test-thumb {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--xl-gold-40);
  background-color: var(--xl-bg-card);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.prov__test-img {
  width: 100%;
  height: 100%;
}
.prov__test-ph {
  width: 26rpx;
  height: 26rpx;
  border: 2rpx solid var(--xl-gold-40);
  border-radius: 4rpx;
  transform: rotate(45deg);
}
.prov__test-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.prov__test-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--xl-text-sub);
}
.prov__test-err {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--xl-danger);
  word-break: break-all;
}


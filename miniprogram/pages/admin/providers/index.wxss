.prov-tip {
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.6;
}
.prov {
  display: flex;
  flex-direction: column;
}
.prov__row1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.prov__name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--xl-text);
}
.prov__meta {
  display: flex;
  margin-top: 10rpx;
}
.prov__type {
  font-size: 22rpx;
  color: var(--xl-thread-blue);
  background: rgba(58, 110, 165, 0.14);
  border: 1rpx solid rgba(58, 110, 165, 0.45);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
  margin-right: 12rpx;
}
.prov__model {
  font-size: 22rpx;
  color: var(--xl-text-sub);
  background: var(--xl-bg-card-2);
  border: 1rpx solid var(--xl-gold-40);
  border-radius: 999rpx;
  padding: 2rpx 16rpx;
}
.prov__foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.prov-add {
  margin-top: 40rpx;
}

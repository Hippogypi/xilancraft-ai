/* 列表项：88rpx 缩略图 + 信息 + 状态 */
.gen {
  display: flex;
  align-items: center;
}
.gen__thumb {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--xl-gold-40);
  background-color: var(--xl-bg-card-2);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gen__img {
  width: 100%;
  height: 100%;
}
.gen__thumb-ph {
  width: 26rpx;
  height: 26rpx;
  border: 2rpx solid var(--xl-gold-40);
  border-radius: 4rpx;
  transform: rotate(45deg);
}
.gen__info {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
}
.gen__time {
  font-size: 22rpx;
  color: var(--xl-text-faint);
}
.gen__model {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--xl-text-sub);
}
.gen__prompt {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--xl-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gen__side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.gen__side .xl-text-faint {
  margin-top: 10rpx;
  font-size: 20rpx;
}

/* 失败记录的错误码（替代提示词行） */
.gen__err {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--xl-danger);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 加载更多 / 全部加载完 */
.gen-more {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}
.gen-end {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
}

/* 详情弹层 */
.gdetail__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.gdetail__label {
  font-size: 24rpx;
  color: var(--xl-gold);
}
.gdetail__value {
  font-size: 24rpx;
  color: var(--xl-text-sub);
}
.gdetail__section {
  margin-top: 24rpx;
}
.gdetail__label {
  display: block;
  margin-bottom: 10rpx;
}
.gdetail__prompt {
  display: block;
  font-size: 26rpx;
  color: var(--xl-text-sub);
  line-height: 1.7;
  background: var(--xl-bg-card-2);
  border: 1rpx solid var(--xl-gold-40);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.gdetail__err {
  display: block;
  font-size: 24rpx;
  color: var(--xl-danger);
}
.gdetail__imgwrap {
  height: 320rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--xl-gold-40);
  background-color: var(--xl-bg-card-2);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.gdetail__img {
  width: 100%;
  height: 100%;
}
.gdetail__img-ph {
  font-size: 22rpx;
  color: var(--xl-text-faint);
}

/* 页头标题 + 使用中徽标 */
.pe-head {
  display: flex;
  align-items: center;
}
.pe-head .xl-tag {
  margin-left: 16rpx;
}

/* API Key 状态标（编辑态显示 已配置密钥 / 未配置） */
.pe-key-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pe-key-label {
  margin-bottom: 0;
}
.pe-key-state {
  font-size: 22rpx;
  color: var(--xl-text-faint);
}
.pe-key-state--on {
  color: var(--xl-success);
}

/* picker 内嵌输入样式 */
.pe-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pe-input__text {
  color: var(--xl-text);
  font-size: 28rpx;
}
.pe-input__arrow {
  color: var(--xl-gold-40);
  font-size: 24rpx;
}

/* 测试生成结果占位 */
.test {
  display: flex;
  align-items: center;
}
.test__thumb {
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--xl-gold-40);
  background-color: var(--xl-bg-card-2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.test__thumb-text {
  font-size: 20rpx;
  color: var(--xl-text-faint);
}
.test__img {
  width: 100%;
  height: 100%;
}
.test__ph {
  width: 26rpx;
  height: 26rpx;
  border: 2rpx solid var(--xl-gold-40);
  border-radius: 4rpx;
  transform: rotate(45deg);
}
.test__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.test__meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--xl-text-sub);
}
.test__err {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--xl-danger);
}

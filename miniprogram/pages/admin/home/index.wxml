<view class="xl-page">
  <view class="xl-admin-badge">管理端</view>
  <view class="xl-page-head">
    <view class="home-head__left">
      <text class="xl-page-title">管理首页</text>
      <text class="xl-text-faint home-head__sub">西兰卡普 AI 定制工坊</text>
    </view>
    <!-- 右上角退出登录 -->
    <view class="home-logout {{loggingOut ? 'home-logout--busy' : ''}}" bindtap="onLogout">{{loggingOut ? '退出中…' : '退出登录'}}</view>
  </view>

  <!-- 统计卡（GET /api/admin/stats，失败显示 --） -->
  <view class="stats">
    <view class="stats__cell">
      <text class="stats__num">{{stats.totalGenerations}}</text>
      <text class="stats__label">生成次数</text>
    </view>
    <view class="stats__cell">
      <text class="stats__num">{{stats.successRate}}</text>
      <text class="stats__label">成功率</text>
    </view>
    <view class="stats__cell">
      <text class="stats__num">{{stats.totalOrders}}</text>
      <text class="stats__label">订单数</text>
    </view>
  </view>

  <!-- 三入口卡 -->
  <view class="xl-card entry" bindtap="goProviders">
    <view class="entry__icon entry__icon--provider"></view>
    <view class="entry__body">
      <text class="entry__name">AI 接口配置</text>
      <text class="entry__desc">绑定生图 Provider、模型与密钥，测试并激活服务</text>
    </view>
    <text class="entry__arrow">›</text>
  </view>

  <view class="xl-card entry" bindtap="goGenerations">
    <view class="entry__icon entry__icon--gen"></view>
    <view class="entry__body">
      <text class="entry__name">生成记录</text>
      <text class="entry__desc">查看历史生成任务、提示词与失败原因</text>
    </view>
    <text class="entry__arrow">›</text>
  </view>

  <view class="xl-card entry" bindtap="goOrders">
    <view class="entry__icon entry__icon--order"></view>
    <view class="entry__body">
      <text class="entry__name">订单管理</text>
      <text class="entry__desc">查看模拟定制订单并流转状态</text>
    </view>
    <text class="entry__arrow">›</text>
  </view>

  <view class="xl-demo-note">比赛演示 · 管理端仅限工作人员使用</view>
</view>

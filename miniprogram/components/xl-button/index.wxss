:host {
  display: block;
}
.xl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 600;
}
.xl-btn__text {
  color: inherit;
}
.xl-btn__spinner {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border: 3rpx solid rgba(245, 237, 222, 0.3);
  border-top-color: var(--xl-text);
  border-radius: 50%;
  animation: xl-btn-spin 0.8s linear infinite;
}
@keyframes xl-btn-spin {
  to { transform: rotate(360deg); }
}

/* 织锦红主按钮：红底 + 米白字 + 金 1rpx 描边 */
.xl-btn--primary {
  background: var(--xl-primary);
  border: 1rpx solid var(--xl-gold);
  color: var(--xl-text);
}
.xl-btn--primary.xl-btn--hover {
  background: var(--xl-primary-deep);
}
/* 幽灵按钮：透明底 + 金描边金字 */
.xl-btn--ghost {
  background: transparent;
  border: 1rpx solid var(--xl-gold-40);
  color: var(--xl-gold);
}
.xl-btn--ghost.xl-btn--hover {
  border-color: var(--xl-gold);
  background: rgba(201, 160, 99, 0.08);
}
/* mini 小按钮 */
.xl-btn--mini {
  width: auto;
  height: 56rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
  font-weight: 500;
  background: transparent;
  border: 1rpx solid var(--xl-gold-40);
  color: var(--xl-gold);
}
.xl-btn--mini.xl-btn--hover {
  border-color: var(--xl-gold);
}
/* 禁用态：40% 透明 */
.xl-btn--disabled {
  opacity: 0.4;
}

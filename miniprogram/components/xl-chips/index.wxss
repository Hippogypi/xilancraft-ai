:host {
  display: block;
}
.xl-chips {
  display: flex;
  flex-wrap: wrap;
}
.xl-chip {
  padding: 10rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--xl-gold-40);
  background: var(--xl-bg-card-2);
  color: var(--xl-text-sub);
  font-size: 26rpx;
  line-height: 1.5;
}
.xl-chip--active {
  border-color: var(--xl-gold);
  color: var(--xl-gold);
  background: rgba(201, 160, 99, 0.12);
}

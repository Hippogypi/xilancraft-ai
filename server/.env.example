# 西兰卡普AI服装定制工坊 - 服务端环境配置示例
# 复制为 server/.env 后按需修改（.env 已被 gitignore，严禁入库）

# 服务端口（契约默认 3000）
PORT=3000
# 监听地址：本机演示用 127.0.0.1；需要真机/局域网访问时改为 0.0.0.0
HOST=0.0.0.0

# 管理员首启种子账号（仅在数据库无管理员时用于初始化，之后以库内哈希为准）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=xilankapu-demo

# AES-256-GCM 密钥（32字节 = 64个hex字符），用于加密存储 Provider 的 API Key
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=8f4a2c91d7be3f05a1c6892db7e4f30c5a9b1d6872cf4e39b0a8d5c712f6e9a3

# 数据目录（SQLite库文件、生成图片、上传图片），相对 server/ 目录
DATA_DIR=./data
